# Copy to secrets.env (git-ignored) and fill with real values:
#   cp infrastructure/k8s/secrets.env.example infrastructure/k8s/secrets.env
# kustomize's secretGenerator turns this file into the `xosting-secrets` Secret
# (content-hashed name, so changing a value triggers a rolling restart).
# In production prefer External Secrets Operator / Sealed Secrets / Vault.

JWT_SECRET=
INTERNAL_API_TOKEN=
AUTH_DJANGO_SECRET_KEY=
BILLING_DJANGO_SECRET_KEY=

POSTGRES_PASSWORD=
AUTH_DB_PASSWORD=
BILLING_DB_PASSWORD=
HOSTING_DB_PASSWORD=
DOMAIN_DB_PASSWORD=
SUPPORT_DB_PASSWORD=

# Must match the passwords above (or point to a managed PostgreSQL instance).
AUTH_DATABASE_URL=postgres://auth_user:<AUTH_DB_PASSWORD>@postgres:5432/auth_db
BILLING_DATABASE_URL=postgres://billing_user:<BILLING_DB_PASSWORD>@postgres:5432/billing_db
HOSTING_DATABASE_URL=postgresql+asyncpg://hosting_user:<HOSTING_DB_PASSWORD>@postgres:5432/hosting_db
DOMAIN_DATABASE_URL=postgresql+asyncpg://domain_user:<DOMAIN_DB_PASSWORD>@postgres:5432/domain_db
SUPPORT_DATABASE_URL=postgresql+asyncpg://support_user:<SUPPORT_DB_PASSWORD>@postgres:5432/support_db

ISPMANAGER_PASSWORD=
SMTP_PASSWORD=
TELEGRAM_BOT_TOKEN=
