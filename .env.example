# =============================================================================
# xosting.net backend — environment configuration
#
#   cp .env.example .env        (or: make env)
#
# Values below are safe *local development* defaults. Every value marked
# CHANGE-ME must be replaced with a strong random secret outside local dev:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
# Passwords are embedded in connection URLs: keep them URL-safe ([A-Za-z0-9_-]).
# =============================================================================

# ----------------------------------------------------------------- general ---
ENVIRONMENT=development
LOG_LEVEL=INFO
# Container registry and tag used by `make build`, docker compose and k8s.
REGISTRY=ghcr.io/shamshodbekdev
TAG=latest

# ---------------------------------------------------- shared security keys ---
# HS256 signing key shared by auth-service (issuer) and every verifier. >= 32 chars.
JWT_SECRET=dev-jwt-secret-CHANGE-ME-0123456789abcdefghijklmnop
JWT_ISSUER=xosting-auth
JWT_AUDIENCE=xosting-api
JWT_ACCESS_TTL_MINUTES=15
JWT_REFRESH_TTL_DAYS=7
# Service-to-service token for /internal/* endpoints (never routed by the gateway).
INTERNAL_API_TOKEN=dev-internal-token-CHANGE-ME

# --------------------------------------------------------------- postgres ---
# One database + one role per service (database-per-service pattern).
POSTGRES_USER=postgres
POSTGRES_PASSWORD=dev_postgres_CHANGE_ME
POSTGRES_PORT=5432
AUTH_DB_PASSWORD=dev_auth_CHANGE_ME
BILLING_DB_PASSWORD=dev_billing_CHANGE_ME
HOSTING_DB_PASSWORD=dev_hosting_CHANGE_ME
DOMAIN_DB_PASSWORD=dev_domain_CHANGE_ME
SUPPORT_DB_PASSWORD=dev_support_CHANGE_ME

# ------------------------------------------------------------------ redis ---
REDIS_PORT=6379
# Redis Stream that carries domain events between services.
EVENTS_STREAM=xosting.events

# ----------------------------------------------- Django (auth + billing) ---
AUTH_DJANGO_SECRET_KEY=dev-auth-django-secret-CHANGE-ME
BILLING_DJANGO_SECRET_KEY=dev-billing-django-secret-CHANGE-ME
DJANGO_DEBUG=false
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,auth-service,billing-service
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost:8080
# gunicorn worker processes per container
WEB_CONCURRENCY=2

# --------------------------------------------------------- billing-service ---
BILLING_CURRENCY=UZS
BILLING_INVOICE_DUE_DAYS=3
BILLING_RENEWAL_LEAD_DAYS=7
BILLING_SUSPEND_GRACE_DAYS=5
# Payment providers (credentials are set per provider in the billing admin).
# Public origin of the gateway, used to build provider webhook URLs.
PAYMENTS_PUBLIC_BASE_URL=http://localhost:8080
# Where providers send the customer after paying (?invoice=<number> is appended).
PAYMENTS_RETURN_URL=http://localhost:3000/billing/invoices

# --------------------------------------------------------- hosting-service ---
# ISPmanager 6 panel used for provisioning (https://<host>:1500).
ISPMANAGER_URL=https://panel.example.com:1500
ISPMANAGER_USERNAME=root
ISPMANAGER_PASSWORD=CHANGE-ME
ISPMANAGER_VERIFY_TLS=true
HOSTING_SERVER_NAME=web-01.xosting.net
# JSON map: billing plan code -> ISPmanager preset (template) name.
HOSTING_PLAN_PRESETS={"hosting-start":"start","hosting-business":"business","hosting-pro":"pro"}

# ---------------------------------------------------------- domain-service ---
RDAP_BASE_URL=https://rdap.org
# Optional JSON overrides:
# DEFAULT_NAMESERVERS=["ns1.xosting.net","ns2.xosting.net"]
# TLD_PRICES={"uz":"60000","com":"165000","net":"185000","org":"175000","io":"520000"}

# ---------------------------------------------------- notification-service ---
# Local dev uses Mailpit (UI: http://localhost:8025). Production: real SMTP + starttls/tls.
SMTP_HOST=mailpit
SMTP_PORT=1025
SMTP_TLS_MODE=none
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=xosting.net <no-reply@xosting.net>
# Create a bot with @BotFather. Leave empty to disable Telegram delivery.
TELEGRAM_BOT_TOKEN=
# Chat/group id that receives staff alerts (new tickets, failed provisioning).
TELEGRAM_ADMIN_CHAT_ID=

# ------------------------------------------------------------- api-gateway ---
GATEWAY_PORT=8080
RATE_LIMIT_DEFAULT=300
RATE_LIMIT_AUTH=10
RATE_LIMIT_WINDOW=1m
CORS_ALLOWED_ORIGINS=http://localhost:3000,https://xosting.net,https://my.xosting.net
# CIDRs whose X-Forwarded-For is trusted (ingress controller / load balancer).
TRUSTED_PROXIES=

# ----------------------------------------------------------- observability ---
# Set to http://jaeger:4318 and run `make up-observability` to export traces.
OTEL_EXPORTER_OTLP_ENDPOINT=
